# Environments
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Data and weights (never commit)
data/*
!data/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
*.pth
*.pt
*.ckpt
*.safetensors
*.zip

# Generated outputs (results/*.csv ARE committed)
