results/per_image/**/*.csv
results/predictions/
results/logs/*.out
demo/my_photos/*
!demo/my_photos/.gitkeep

# Not part of the public code release (paper, slides, working notes): kept outside the repository
paper/
presentation/
project_materials/
CLAUDE.md
PROGRESS.md
figures/intermediates/
